# ============================================================
# 班主任工作台 - 环境变量示例
# 复制本文件为 .env 后按需修改
# ============================================================

# 数据库连接（默认 SQLite 零配置；如需切换 PostgreSQL，改为：
# DATABASE_URL=postgresql+psycopg2://postgres:密码@localhost:5432/class_manager
DATABASE_URL=sqlite:///./class_manager.db

# 监护人手机号加密密钥（Fernet 格式）。首次启动若为空，系统会自动生成并写入本文件。
# 重要：备份恢复或更换机器时请保持该密钥不变，否则无法解密手机号。
ENCRYPTION_KEY=

# 默认管理员账号（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 服务端口
HOST=0.0.0.0
PORT=8000

# 定时备份：备份目录与备份时刻（24小时制）
BACKUP_DIR=./backup
BACKUP_HOUR=2
BACKUP_MINUTE=0
