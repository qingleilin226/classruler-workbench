# ============================================================
# 班主任工作台 - 环境变量示例
# 复制本文件为 .env 后按需修改
# ============================================================

# 数据库连接（默认 SQLite 零配置；如需切换 PostgreSQL，改为：
# DATABASE_URL=postgresql+psycopg2://postgres:密码@localhost:5432/class_manager
DATABASE_URL=sqlite:///./class_manager.db

# 监护人手机号加密密钥（Fernet 格式）。首次启动若为空，系统会自动生成并写入本文件。
# 重要：备份恢复或更换机器时请保持该密钥不变，否则无法解密手机号。
ENCRYPTION_KEY=

# 默认管理员账号（首次启动自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 服务端口
HOST=0.0.0.0
PORT=8000

# 前后端同源部署时保持为空；仅在独立前端开发服务器需要跨域时填写，多个来源用逗号分隔
# CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=

# 定时备份：备份目录与备份时刻（24小时制）
BACKUP_DIR=./backup
BACKUP_HOUR=2
BACKUP_MINUTE=0
BACKUP_KEEP_COUNT=30

# 运行日志自动轮转：默认每个文件 5MB，保留 5 个历史文件
LOG_FILE=./server.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
